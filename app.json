{
  "expo": {
    "name": "receipt-market",
    "slug": "receipt-market",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "receipt-market",
    "platforms": ["ios", "android", "web"],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.receiptmarket.app",
      "cameraUsageDescription": "Βγάλε φωτογραφία την απόδειξη για αυτόματη καταχώρηση τιμών."
    },
    "android": {
      "package": "com.receiptmarket.app",
      "permissions": ["CAMERA", "NOTIFICATIONS"],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        { "icon": "./assets/icon.png", "color": "#007AFF" }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "favicon": "./assets/favicon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E10"
    },
    "extra": {
      "eas": {
        "projectId": "placeholder-replace-me"
      }
    }
  }
}
